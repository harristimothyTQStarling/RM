# Copy to .env for local dev. In production these are Railway service variables —
# never commit real values (.env is gitignored).

# ---------------------------------------------------------------- database --
# Railway injects DATABASE_URL automatically when you add the Postgres plugin.
DB_DRIVER=postgres
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# ------------------------------------------------------------------- auth --
# From the Entra app registration. PUBLIC_URL must exactly match the redirect
# URI you register (no trailing slash) — Entra rejects mismatches.
AAD_TENANT_ID=
AAD_CLIENT_ID=
AAD_CLIENT_SECRET=
PUBLIC_URL=https://<your-app>.up.railway.app

# Signs the session cookie. Generate with:  openssl rand -base64 48
# Changing this signs everyone out (which is also how you revoke all sessions).
SESSION_SECRET=

# Who may EDIT the plan. Everyone else who signs in is read-only.
# Comma-separated; case-insensitive; takes effect without a redeploy.
EDITOR_UPNS=tim@tqstarling.com

# ------------------------------------------------------------------- odoo --
# Read-only service account. The app never writes to Odoo.
ODOO_URL=https://tq-starling.odoo.com   # confirmed; note: NO /en suffix
ODOO_DB=tq-starling
ODOO_USER=
ODOO_PASSWORD=

# ------------------------------------------------------- local dev only ----
# Impersonate a user when Entra isn't configured. Hard-disabled when NODE_ENV=
# production or when the AAD_* vars are set, so it can never work in the deploy.
# DEV_USER=tim@tqstarling.com
